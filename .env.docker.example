# Group Planner - Docker Environment Configuration
# Copy this file to .env when running with docker-compose
#
# IMPORTANT: This file uses Docker service hostnames (postgres, redis)
# For local development WITHOUT Docker, use .env.example instead

# ===== DATABASE CONFIGURATION =====
# Uses Docker service name 'postgres' instead of 'localhost'
DATABASE_URL="postgresql://planner:planner@postgres:5432/groupplanner"

# ===== REDIS CONFIGURATION =====
# Uses Docker service name 'redis' instead of 'localhost'
REDIS_URL="redis://redis:6379"

# ===== POSTGRES CONTAINER SETTINGS =====
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner
POSTGRES_DB=groupplanner

# ===== JWT AUTHENTICATION =====
# REQUIRED: Generate a secure secret with: openssl rand -base64 64
JWT_SECRET="change-this-to-a-secure-random-string-min-256-bits"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# ===== APPLICATION SETTINGS =====
NODE_ENV="development"
APP_URL="http://localhost:4000"
API_URL="http://localhost:4000"

# CORS origins (frontend URL)
CORS_ORIGINS="http://localhost:5173"

# ===== EMAIL CONFIGURATION =====
# For development, use MailHog (see docker-compose.dev.yml)
# MailHog SMTP: localhost:1025, Web UI: localhost:8025
SMTP_HOST="mailhog"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Group Planner"
SMTP_FROM_EMAIL="noreply@groupplanner.app"

# ===== LOGGING =====
LOG_LEVEL="debug"

# ===== FILE UPLOAD =====
MAX_FILE_SIZE="10485760"
UPLOAD_DIR="./uploads"

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW="900000"
RATE_LIMIT_MAX="100"

# ===== FRONTEND VARIABLES =====
VITE_API_URL="http://localhost:4000"
VITE_APP_NAME="Group Planner"
VITE_ENABLE_DEVTOOLS="true"

# ===== DEVELOPMENT =====
DEBUG_MODE="true"
ENABLE_QUERY_LOGGING="false"
