FROM oven/bun:latest AS deps

WORKDIR /app

# Copy workspace definition for Bun workspace resolution
COPY package.json bun.lock tsconfig.json ./
COPY backend/package.json backend/tsconfig.json ./backend/
COPY frontend/package.json ./frontend/

# Install dependencies once to reuse across stages
RUN bun install

FROM oven/bun:latest AS backend-build

WORKDIR /app
COPY --from=deps /app /app
COPY backend/ ./backend/

RUN bun run --filter "@group-planner/backend" build

FROM oven/bun:latest AS runtime

WORKDIR /app/backend

COPY --from=deps /root/.bun /root/.bun
COPY --from=deps /app/node_modules ./node_modules
COPY --from=backend-build /app/backend/dist ./dist
COPY --from=backend-build /app/backend/prisma ./prisma
COPY backend/package.json ./package.json
COPY backend/tsconfig.json ./tsconfig.json

ENV NODE_ENV=production

CMD ["node", "dist/index.js"]
