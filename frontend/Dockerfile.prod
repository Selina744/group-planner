FROM oven/bun:latest AS deps

WORKDIR /app

# Workspace dependencies for Bun
COPY package.json bun.lock tsconfig.json ./
COPY frontend/package.json frontend/tsconfig.json ./frontend/
COPY backend/package.json ./backend/

RUN bun install

FROM oven/bun:latest AS frontend-build

WORKDIR /app
COPY --from=deps /app /app
COPY frontend/ ./frontend/

RUN bun run --filter "@group-planner/frontend" build

FROM oven/bun:latest AS runtime

WORKDIR /app/frontend

COPY --from=deps /root/.bun /root/.bun
COPY --from=deps /app/node_modules ./node_modules
COPY --from=frontend-build /app/frontend/dist ./dist
COPY frontend/package.json ./package.json
COPY frontend/tsconfig.json ./tsconfig.json

ENV NODE_ENV=production

CMD ["bun", "run", "--filter", "@group-planner/frontend", "--", "preview", "--host", "0.0.0.0", "--port", "3001"]
